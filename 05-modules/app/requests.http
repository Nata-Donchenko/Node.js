### Отримати всі рецензії
# Очікується: 200, масив усіх рецензій
GET http://localhost:3005/reviews

### Отримати рецензії книжки з ІД 1
# Очікується: 200, лише рецензії з bookId: 1
GET http://localhost:3005/reviews?bookId=1

### Отримати рецензії книжки з неіснуючим ід
# Очікується: 200, порожній масив [] (у неіснуючої книжки рецензій немає)
GET http://localhost:3005/reviews?bookId=999

### Створити рецензію для існуючої книжки
# Очікується: 201, нова рецензія з наступним вільним id
POST http://localhost:3005/reviews
Content-Type: application/json

{
  "bookId": 1,
  "text": "Класика, яку варто перечитувати",
  "rating": 5
}

### Створити рецензію для неіснуючої книжки
# Очікується: 404, книжку з id=999 не знайдено
POST http://localhost:3005/reviews
Content-Type: application/json

{
  "bookId": 999,
  "text": "Такої книжки немає",
  "rating": 4
}

### Створити рецензію з оцінкою поза діапазоном
# Очікується: 400, оцінка має бути цілим числом 1-5
POST http://localhost:3005/reviews
Content-Type: application/json

{
  "bookId": 1,
  "text": "Дуже-дуже сподобалось",
  "rating": 7
}

### Видалити рецензію з нечисловим id
# Очікується: 400, id має бути числом
DELETE http://localhost:3005/reviews/abc

### Видалити неіснуючу рецензію
# Очікується: 404, рецензію з id=999 не знайдено
DELETE http://localhost:3005/reviews/999

### Видалити існуючу рецензію
# Очікується: 204, порожня відповідь
DELETE http://localhost:3005/reviews/1

### Середній рейтинг книжки з рецензіями
# Очікується: 200, { bookId: 2, averageRating: 4.5 }
GET http://localhost:3005/books/2/rating

### Середній рейтинг книжки без рецензій
# Очікується: 200, { bookId: ..., averageRating: null }
GET http://localhost:3005/books/1/rating

### Середній рейтинг неіснуючої книжки
# Очікується: 404, книжку не знайдено
GET http://localhost:3005/books/999/rating